{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guplem/eva/main/docs/widgets/manifest-v4.json",
  "title": "eva-widget.json, contract 4",
  "description": "The manifest of a widget. docs/widgets.md describes each key. A new key needs a new contract.",
  "type": "object",
  "required": ["contract", "name", "size"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": 4 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "entry": {
      "description": "The page that Eva opens, by its path from the repository root. index.html when not given.",
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+\\.html$",
      "default": "index.html"
    },
    "size": { "enum": ["small", "medium", "large", "tall", "xlarge", "header"] },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" },
      "default": []
    },
    "hosts": {
      "type": "array",
      "items": { "$ref": "#/$defs/host" },
      "default": []
    },
    "asks": {
      "description": "What the widget may ask Eva to do, by a message to its parent window. Each type at most once.",
      "type": "array",
      "items": { "$ref": "#/$defs/ask" },
      "allOf": [
        { "contains": { "properties": { "type": { "const": "chat" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "type": { "const": "open" } } }, "minContains": 0, "maxContains": 1 }
      ],
      "default": []
    },
    "prompt": {
      "description": "One line for Eva's prompt. {<input id>} names the value of an input.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\n]*$"
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": ["id", "type", "label", "description", "why", "required"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "A camelCase name. It is a key of config.json and a folder of data/.",
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,39}$"
        },
        "type": {
          "enum": [
            "folder",
            "file",
            "text",
            "url",
            "number",
            "boolean",
            "choice",
            "eva-location",
            "eva-google-calendar",
            "eva-google-tasks",
            "eva-cases"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "default": true,
        "access": { "enum": ["read", "write"] },
        "schema": {
          "description": "The JSON Schema of each file that the widget writes, by its path from the repository root.",
          "type": "string",
          "pattern": "^schemas/[A-Za-z0-9._-]+\\.json$"
        },
        "files": {
          "description": "A glob pattern of the file names of the folder, such as *.json. * and ? match no slash.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._*?-]+$"
        },
        "choices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["folder", "file"] } } },
          "then": { "required": ["access"] },
          "else": {
            "if": { "properties": { "type": { "enum": ["eva-google-calendar", "eva-google-tasks"] } } },
            "then": { "required": ["access"], "not": { "required": ["schema"] } },
            "else": { "not": { "anyOf": [{ "required": ["access"] }, { "required": ["schema"] }] } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "folder" } } },
          "then": { "required": ["files"] },
          "else": { "not": { "required": ["files"] } }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["folder", "file"] }, "access": { "const": "write" } },
            "required": ["access"]
          },
          "then": { "required": ["schema"] }
        },
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "required": ["choices"] },
          "else": { "not": { "required": ["choices"] } }
        },
        {
          "description": "An input of Eva's own data has no value, so it has no default.",
          "if": {
            "properties": {
              "type": { "enum": ["eva-location", "eva-google-calendar", "eva-google-tasks", "eva-cases"] }
            }
          },
          "then": { "not": { "required": ["default"] } }
        }
      ]
    },
    "ask": {
      "type": "object",
      "required": ["type", "why"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "chat puts a text in Eva's message box. open opens a page of Eva for a vault path.",
          "enum": ["chat", "open"]
        },
        "why": { "type": "string", "minLength": 1 }
      }
    },
    "host": {
      "type": "object",
      "required": ["url", "why"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "An https address with no path, such as https://api.example.com.",
          "type": "string",
          "pattern": "^https://[a-z0-9.-]+(?::[0-9]{1,5})?$"
        },
        "why": { "type": "string", "minLength": 1 }
      }
    }
  }
}
