{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(//tmp/claude-*/**)",
      "Agent",
      "ToolSearch",
      "ScheduleWakeup",
      "ReadNotifications",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch --show-current*)",
      "Bash(git branch --list*)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rm *)",
      "Bash(git checkout -b *)",
      "Bash(git restore --staged *)",
      "Bash(git push)",
      "Bash(git push -q)",
      "Bash(git push origin *)",
      "Bash(git push -q origin *)",
      "Bash(git push -u origin *)",
      "Bash(git push -q -u origin *)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr update-branch*)",
      "Bash(gh pr merge *)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh label list*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx playwright *)",
      "Bash(uv run .pskill/pskill.py *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -c \"import os, subprocess, sys; root = os.environ.get('CLAUDE_PROJECT_DIR', ''); runner = root + '/.pskill/pskill.py'; arguments = ['uv', 'run', runner, 'hook', 'stop', '--harness', 'claude-code']; os.path.isfile(runner) and subprocess.call(arguments); sys.exit(0)\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -c \"import os, subprocess, sys; root = os.environ.get('CLAUDE_PROJECT_DIR', ''); runner = root + '/.pskill/pskill.py'; arguments = ['uv', 'run', runner, 'hook', 'session-start', '--harness', 'claude-code']; os.path.isfile(runner) and subprocess.call(arguments); sys.exit(0)\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
