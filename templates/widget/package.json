{
  "name": "example-widget",
  "version": "0.0.0",
  "private": true,
  "description": "A widget for Eva's home page.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "check": "npm run format:check && npm run lint && npm run check:widget && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:widget": "node scripts/check-widget.js",
    "test": "node --test \"tests/*.test.js\" && playwright test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10"
  }
}
